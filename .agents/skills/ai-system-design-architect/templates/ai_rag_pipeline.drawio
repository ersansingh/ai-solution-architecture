        <mxCell id="vectorStore" value="Vector Database&#xa;(Vector Store Index)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#FFFFFF;strokeColor=#2563EB;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="ingestionBox">
